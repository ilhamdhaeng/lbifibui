<?php

/**
 * @file
 * Primary module hooks for LBIFIBUI Core module.
 */

use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Entity\EntityInterface;

/**
 * Implements hook_form_FORM_ID_alter() untuk form pendaftaran user.
 */
function lbifibui_core_form_user_register_form_alter(&$form, \Drupal\Core\Form\FormStateInterface $form_state, $form_id) {
  
  if (isset($form['field_kewarganegaraan'])) {
    
    // 1. Selector Universal
    // Menggunakan :input agar kompatibel entah form dirender sebagai Select maupun Radio
    $selector = ':input[name="field_kewarganegaraan"]'; 

    // GANTI 'wna' dan 'wni' DI BAWAH INI JIKA KEY DI DATABASE ANDA BERBEDA.
    // Ini bersifat case-sensitive. Harus sama dengan atribut HTML value="..." di browser.
    
    $kondisi_wna = [
      'visible' => [
        $selector => ['value' => 'wna'], // Ubah menjadi 'wna' jika key Anda huruf kecil
      ],
    ];

    $kondisi_wni = [
      'visible' => [
        $selector => ['value' => 'wni'], // Ubah menjadi 'wni' jika key Anda huruf kecil
      ],
    ];

    // 2. Terapkan #states
    // Cukup terapkan pada level tertinggi array field.
    
    if (isset($form['field_kitas'])) {
      $form['field_kitas']['#states'] = $kondisi_wna;
    }
    
    if (isset($form['field_passport'])) {
      $form['field_passport']['#states'] = $kondisi_wna;
    }

    if (isset($form['field_idcard'])) {
      $form['field_idcard']['#states'] = $kondisi_wni;
    }
  }
}

/**
 * Implements hook_ENTITY_TYPE_presave() untuk entitas User.
 *
 * Mengontrol status aktif/blokir akun baru berdasarkan kewarganegaraan.
 */
function lbifibui_core_user_presave(EntityInterface $entity) {
  if ($entity->isNew()) {
    
    if ($entity->hasField('field_kewarganegaraan') && !$entity->get('field_kewarganegaraan')->isEmpty()) {
      $kewarganegaraan = $entity->get('field_kewarganegaraan')->value;
      
      if ($kewarganegaraan === 'wni') {
        $entity->activate();
      }
      elseif ($kewarganegaraan === 'wna') {
        $entity->block();
      }
    }
  }
}